# Copy this file to .env. The defaults work with `docker compose up -d`.

BASELINE_DATABASE_URL=postgresql+psycopg://baseline:baseline@localhost:5432/baseline
BASELINE_TEST_DATABASE_URL=postgresql+psycopg://baseline:baseline@localhost:5432/baseline_test

# "local" keeps files in .baseline_storage/. Use "s3" to go through LocalStack or AWS.
BASELINE_STORAGE=local
BASELINE_S3_BUCKET=baseline-files
BASELINE_S3_ENDPOINT_URL=http://localhost:4566
BASELINE_AWS_REGION=us-east-1

# LocalStack accepts any credentials.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test